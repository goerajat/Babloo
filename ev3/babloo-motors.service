[Unit]
Description=Babloo motor server (UDP -> EV3 motors, with dead-man stop)
After=network.target

[Service]
Type=simple
User=robot
Group=robot
WorkingDirectory=/home/robot/babloo
ExecStart=/usr/bin/python3 -u /home/robot/babloo/motor_server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
